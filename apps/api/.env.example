PORT=5000
NODE_ENV=development

# MongoDB Atlas
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=EasyFundDB

# JWT secrets (generate unique secrets for each)
ACCESS_TOKEN_SECRET=generate-a-unique-64-char-hex-string
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_SECRET=generate-a-different-unique-64-char-hex-string
REFRESH_TOKEN_EXPIRY=7d

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_signing_secret

# Firebase Admin SDK
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-firebase-client-email@project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Email (Mailgun)
EMAIL_PRIVATE_KEY=your-mailgun-private-key
EMAIL_DOMAIN=your-mailgun-domain

# Frontend URL
FRONTEND_URL=http://localhost:3000
